@page "/mywork"
@using YeagerDotNet.Models
@using YeagerDotNet.Components
@using YeagerDotNet.Services
@inject HttpClient Http
@inject UtilityService Utility

<PageTitle>My Work</PageTitle>

<h1 class="page-title">all work and no work makes work a dull work</h1>

<div class="container">
    @if (workExperiences == null)
    {
        <p>Loading work experiences...</p>
    }
    else
    {
        @foreach (var exp in workExperiences.OrderByDescending(e => e.StartDate ?? DateOnly.MaxValue))
        {
            <Window Title="@exp.Company" CssClass="experience-window">
                @if (!string.IsNullOrEmpty(exp.GraphicPath)) 
                {
                    <div class="experience-graphic-block">
                        <img src="@exp.GraphicPath"
                            alt="@($"{exp.Company} logo")"
                            class="experience-logo" />
                    </div>
                }
                
                @if (!string.IsNullOrWhiteSpace(exp.Role))
                {
                    <h4>@exp.Role</h4>
                }

                @if (exp.StartDate.HasValue)
                {
                    <h5 class="date-subtitle">@Utility.FormatDateRange(exp.StartDate.Value, exp.EndDate)</h5>
                }

                @if (!string.IsNullOrWhiteSpace(exp.Description))
                {
                    <p>@exp.Description</p>
                }

                @if (exp.Projects != null && exp.Projects.Any())
                {
                    <table class="win-list">
                        <thead>
                            <tr>
                                <th>Project</th>
                                <th>Description</th>
                                <th>Skills</th>
                                <th>Links</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in exp.Projects!)
                            {
                                <tr>
                                    <td>@p.Title</td>
                                    <td>@p.Description</td>
                                    <td>
                                        @if (p.Skills != null && p.Skills.Any())
                                        {
                                            <div class="skill-list">
                                                @foreach (var skill in p.Skills)
                                                {
                                                    <button class="skill-button">@skill</button>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <div class="button-group">
                                            @if (!string.IsNullOrEmpty(p.WebLink))
                                            {
                                                <button class="win98-button"
                                                        @onclick='() => JSRuntime.InvokeVoidAsync("open", p.WebLink, "_blank")'>
                                                    @p.ButtonText
                                                </button>
                                            }
                                            @if (!string.IsNullOrEmpty(p.PreviewPath))
                                            {
                                                <button class="win98-button" @onclick='() => TogglePreview(exp, p)'>
                                                    Preview
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>

                                @if (_previewExp == exp && _previewProj == p)
                                {
                                    <tr class="preview-row">
                                        <td colspan="4">
                                            @if (Utility.IsImageFile(p.PreviewPath))
                                            {
                                                <img src="@p.PreviewPath" alt="Preview" class="inline-preview" />
                                            }
                                            else
                                            {
                                                <iframe src="@p.PreviewPath" class="inline-preview"></iframe>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }
            </Window>
        }
    }
</div>

@code {
    [Inject]
    public IJSRuntime JSRuntime { get; set; } = null!;

    private List<WorkExperience>? workExperiences;

    protected override async Task OnInitializedAsync()
    {
        var loadedExperiences = await Http.GetFromJsonAsync<List<WorkExperience>>("data/work.json");

        if (loadedExperiences != null)
        {
            workExperiences = loadedExperiences.Select(exp => new WorkExperience
            {
                Company = exp.Company,
                Role = exp.Role,
                StartDate = exp.StartDate,
                EndDate = exp.EndDate,
                Description = exp.Description,
                Projects = exp.Projects,
                GraphicPath = exp.GraphicPath
            }).ToList();
        }
    }

    private WorkExperience? _previewExp;
    private Project? _previewProj;

    private void TogglePreview(WorkExperience exp, Project proj)
    {
        if (_previewExp == exp && _previewProj == proj)
        {
            _previewExp = null;
            _previewProj = null;
        }
        else
        {
            _previewExp = exp;
            _previewProj = proj;
        }
    }
}