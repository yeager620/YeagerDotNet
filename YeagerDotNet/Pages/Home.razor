@page "/"
@using YeagerDotNet.Components

<PageTitle>Evan Yeager - Home</PageTitle>

<div class="container home-container">
    <Window CssClass="profile-section">
        <img src="files/webheadshot.JPG" alt="Evan Yeager" class="profile-image" fetchpriority="high" />
    </Window>

    <Window Title="About" CssClass="bio-section">
        <h1>Evan Yeager</h1>
        <p>Co-Founder & CEO at Maquoketa Research (YC P26)</p>
        <p>Currently working on drone manufacturing and autonomous flight technologies</p>
        <p>Berkeley EECS B.S. as of December 2025</p>
        <p>I experience dunning-kreuger on an hourly basis</p>
    </Window>

    <Window Title="Contact" CssClass="contact-section">
        <ul>
            <li><strong>Email:</strong> <a href="mailto:evan@maquoketa.net">evan@maquoketa.net</a></li>
            <li><strong>Other Email:</strong> <a href="mailto:yeager@berkeley.edu">yeager@berkeley.edu</a></li>
            <li><strong>LinkedIn:</strong> <a href="https://linkedin.com/in/evanyeager" target="_blank">in</a></li>
            <li><strong>GitHub:</strong> <a href="https://github.com/yeager620" target="_blank">yeager620</a></li>
            <li><strong>HuggingFace:</strong> <a href="https://huggingface.co/totalorganfailure" target="_blank">totalorganfailure</a></li>
        </ul>
    </Window>
</div>

<Window Title="Some Awards" CssClass="technical-writing-section">
    <div class="writing-list">
        <Window Title="MathCON Finals Honorable Mention" CssClass="writing-item-window">
            <p>Was an honorable mention at MathCON Finals 2022;
            stats for the competition on a per-award basis weren't published (or at least in any interpretable form)
            but based on total participants, total number of grade levels participating,
            and number of people who got honorable mention or higher that year, I estimate that I was within the Top 12 out of ~3000 other Juniors, i.e. Top 0.4%</p>

            <div class="button-group">
                <button class="win98-button" @onclick="() => ToggleMathConPreview()">
                    @(ShowMathConPreview ? "Hide" : "Medal")
                </button>
            </div>

            @if (ShowMathConPreview)
            {
                <div class="image-preview">
                    <img src="files/mathcon_medal.png"
                        alt="MathCON medal"
                        class="inline-preview-img"
                        loading="lazy" />
                </div>
            }
        </Window>

        <Window Title="Top 3 Paper / Featured Researcher: CPS Capstone Journal" CssClass="writing-item-window">
            <p>Was published in a journal for research done by highschool students in CPS, selected as one of the top 3 papers in 2023</p>
            <p>Journal: <a href="https://sites.google.com/cps.edu/journalofcpscapstoneresearch/home?authuser=0" target="_blank">The Chicago Public School's Journal of AP Capstone Research</a></p>
        </Window>
    </div>
</Window>

<Window Title="Some of my technical writing and notes" CssClass="technical-writing-section">
    <div class="writing-list">
        <Window Title="Generalized Kelly Criterion" CssClass="writing-item-window">
            <p>A technical note from one of my projects on MLB game prediction and betting model development since I needed to determine an optimal strategy for certain types of bets with outcomes that could result in a tie.</p>
            <PdfPreviewButton PreviewUrl="files/Generalized_Kelly.pdf" />
        </Window>

        <Window Title="Electromyographic Analysis of Row Exercises" CssClass="writing-item-window">
            <p>A comparative analysis of muscle activation patterns across different rowing exercise variations using surface electromyography</p>
            <PdfPreviewButton PreviewUrl="files/emg.pdf" />
        </Window>
    </div>
</Window>

<style>
    .image-preview {
        max-width: 280px;
    }

    .inline-preview-img {
        display: block;
        width: 100%;
        height: auto;
        image-rendering: -webkit-optimize-contrast;
    }

    .technical-writing-section {
        margin-top: 2rem;
        max-width: none;
        width: 100%;
    }

    .writing-list {
        max-width: 1200px;
        margin: 0 auto;
    }

    .writing-item-window {
        margin-bottom: 2rem;
    }

    .button-group {
        display: flex;
        gap: 0.5rem;
        margin-top: 1rem;
    }

    .win98-button {
        padding: 2px 8px;
        font-family: "MS Sans Serif", Arial, sans-serif;
        font-size: 12px;
        background: #c0c0c0;
        color: #000;
        border: 2px solid;
        border-color: #dfdfdf #000 #000 #dfdfdf;
        box-shadow: 1px 1px #000;
        position: relative;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .win98-button:active {
        border-color: #000 #dfdfdf #dfdfdf #000;
        box-shadow: -1px -1px #000;
    }

    .writing-icon {
        font-size: 12px;
        line-height: 1;
    }

    .writing-preview {
        margin-top: 1rem;
    }

    .inline-preview {
        width: 100%;
        height: 600px;
        border: 2px solid;
        border-color: #000 #dfdfdf #dfdfdf #000;
        background: white;
    }
</style>

@code {
    private bool ShowMathConPreview { get; set; } = false;

    private void ToggleMathConPreview()
    {
        ShowMathConPreview = !ShowMathConPreview;
    }
}

